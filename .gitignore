# Local scratch/debug files
c.txt
mintest/

# Local build snapshots (see backups/*/MANIFEST.txt). Hundreds of MB of
# packaged output per snapshot, and reproducible from the commit each one
# records -- so they stay on this machine.
backups/

# SQLite artifacts if ever created outside userData during local testing
*.db
*.db-journal
*.db-wal
*.db-shm
*.tsbuildinfo

# Exported clips live inside the app folder by default (see clipService.ts),
# so keep the user's own video output out of version control.
clips/

# Recordings the app makes itself land here by default (see outputPaths.ts),
# including the replay buffer's segment ring. Same reasoning as clips/.
recordings/
