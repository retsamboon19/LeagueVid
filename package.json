{
  "name": "leaguevid",
  "version": "0.4.0",
  "description": "Tag key moments in your League of Legends recordings, auto-synced from Riot match data",
  "main": "./out/main/index.js",
  "author": "LeagueVid",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:beta": "node scripts/build-private-beta.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.1",
    "@electron-toolkit/utils": "4.0.0",
    "dotenv": "16.4.7",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "0.474.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.13.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "1.0.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/sql.js": "1.4.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.4.5",
    "electron-builder": "25.1.8",
    "electron-vite": "3.0.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.9"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron@33.4.5": true,
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
